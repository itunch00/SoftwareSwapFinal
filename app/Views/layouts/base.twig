<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}UAFS Social{% endblock %}</title>
  <style>
    :root { color-scheme: light; }

    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
      background: #f7f7fb;
      color: #1f2937;
    }

    a { color: #2c6bed; text-decoration: none; }

    .topnav{
      display:flex;justify-content:space-between;align-items:center;
      padding:.75rem 1rem;border-bottom:1px solid #eee;background:#fff;
      position:sticky;top:0;z-index:10
    }
    .brand{font-weight:700;margin-right:1rem;text-decoration:none;color:#1f2937}
    .nav-left,.nav-right{display:flex;gap:.75rem;align-items:center}
    .nav-link{padding:.25rem .5rem;text-decoration:none;border-radius:.4rem;color:#1f2937}
    .nav-link.active{background:#f2f4f7}
    .nav-user{font-size:.9rem;color:#667085}
    .linklike{background:none;border:none;padding:0;color:#2c6bed;cursor:pointer;font:inherit}
    .linklike:hover{text-decoration:underline}

    /* Breadcrumbs (new) */
    .breadcrumb{font-size:.9rem;margin:0 0 .5rem;color:#667085}
    .breadcrumb a{color:inherit;text-decoration:none}
    .breadcrumb a:hover{text-decoration:underline}

    .page-wrap {
      min-height: 100vh;
      padding: 48px 16px;
      display: flex;
      flex-direction: column;
      gap: 24px;
      align-items: center;
    }

    .page-card {
      width: 100%;
      max-width: 860px;
      background: #fff;
      padding: 28px 32px;
      border: 1px solid #e6e6ee;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0,0,0,.04);
    }

    .page-card.centered { text-align: center; }

    .auth-wrap { min-height: 100vh; display: grid; place-items: center; background: #f7f7fb; }
    .auth-card { width: 100%; max-width: 480px; background: #fff; padding: 28px 32px; border: 1px solid #e6e6ee; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,.06); }
    .auth-header h1 { margin: 0 0 4px; font-size: 24px; }
    .subtitle { margin: 0 0 20px; color: #666; }

    .field { margin-bottom: 14px; }
    .field label { font-weight: 600; display: block; margin-bottom: 6px; }
    .field input, .field select { width: 100%; padding: 10px 12px; border: 1px solid #d4d4df; border-radius: 8px; font-size: 14px; outline: none; }
    .field input:focus, .field select:focus { border-color: #5c6ac4; box-shadow: 0 0 0 3px rgba(92,106,196,.15); }
    .hint.small { font-size: 12px; color: #888; margin-top: 4px; }

    .row-between { display: flex; align-items: center; justify-content: space-between; margin: 10px 0 16px; }
    .checkbox { display: inline-flex; gap: 8px; align-items: center; cursor: pointer; }
    .muted { color: #666; }
    .small { font-size: 13px; }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 12px 18px;
      border-radius: 10px;
      border: 0;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: background .2s ease, color .2s ease, box-shadow .2s ease;
    }

    .btn.primary {
      background: #2c6bed;
      color: #fff;
      box-shadow: 0 6px 16px rgba(44,107,237,.18);
    }
    .btn.primary:hover { background: #2359cc; }

    .btn.secondary {
      background: #eef2ff;
      color: #3730a3;
      border: 1px solid #c7d2fe;
    }
    .btn.secondary:hover { background: #e0e7ff; }

    .auth-card .btn.primary { width: 100%; }

    .alert { background: #fde8e8; color: #b91c1c; border: 1px solid #f8c7c7; padding: 10px 12px; border-radius: 8px; margin-bottom: 14px; }
    .switch { text-align: center; margin-top: 12px; }
    
    .nav-link:hover {
      background: #f2f4f7;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .04em;
    }
    .badge.public { background: #ecfdf5; color: #047857; }
    .badge.private { background: #fef3c7; color: #b45309; }
    .badge.subtle { background: #f4f4f7; color: #6b7280; text-transform: capitalize; letter-spacing: normal; }

    .group-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; }
    .group-header h1 { margin: 0 0 8px; font-size: 28px; }

    .group-actions { margin-top: 24px; }
    .group-actions form { display: inline; }
    .group-actions form + form { margin-left: 12px; }

    .channel-list { list-style: none; padding: 0; margin: 20px 0 0; display: flex; flex-direction: column; gap: 12px; }
    .channel-list li {
      display: flex; justify-content: space-between; align-items: center;
      padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 10px;
    }
    .channel-name { font-weight: 600; }

    @media (max-width: 640px) {
      .page-card { padding: 24px 20px; }
      .group-header { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
<body>
  {% include 'partials/nav.twig' %}

  {% block body %}{% endblock %}
</body>
</html>
