{% extends "layouts/base.twig" %}
{% block title %}#{{ channel.name }} — {{ group.name }} — UAFS Social{% endblock %}
{% set me = app.user %}

{% block body %}
<div class="page-wrap">

  {% set f = flash() %}
  {% for msg in f.success ?? [] %}
    <div class="alert alert-success">{{ msg }}</div>
  {% endfor %}
  {% for msg in f.error ?? [] %}
    <div class="alert alert-error">{{ msg }}</div>
  {% endfor %}

  <section class="chat-wrapper">
    <!-- Channel Header -->
    <header class="chat-header">
      <div class="chat-title">
        <a href="/groups/{{ group.slug }}" class="back-link">&larr; {{ group.name }}</a>
        <h1>#{{ channel.name }}</h1>
      </div>

      <div class="channel-tags">
        <span class="badge subtle">{{ channel.kind|title }}</span>
        {% if channel.is_readonly %}
          <span class="badge subtle">Readonly</span>
        {% endif %}
      </div>

      {% if me and me.role == 'admin' %}
        <form method="post"
              action="/groups/{{ group.slug }}/channels/{{ channel.slug }}/delete"
              class="delete-form">
          <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
          <input name="reason" type="text" placeholder="Reason (optional)" class="input small">
          <button class="btn danger small" type="submit">Delete Channel</button>
        </form>
      {% endif %}
    </header>

    <!-- About -->
    {% if channel.description %}
      <div class="channel-about">
        <p class="muted">{{ channel.description }}</p>
      </div>
    {% endif %}

    <!-- Messages -->
    <div class="chat-body">
      {% if messages and messages|length > 0 %}
        {% for m in messages %}
          <div class="message-card">
            <div class="message-head">
              <strong>{{ m.user_name }}</strong>
              <span class="muted small">{{ m.created_at|date('Y-m-d H:i') }}</span>
              {% if app.user and app.user.role == 'admin' %}
                <form method="post"
                      action="/groups/{{ group.slug }}/channels/{{ channel.slug }}/messages/{{ m.id }}/delete"
                      style="display:inline;">
                  <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                  <button class="btn danger tiny" type="submit" title="Delete message">🗑️</button>
                </form>
              {% endif %}
            </div>
            <div class="message-body">{{ m.body }}</div>
          </div>
        {% endfor %}
      {% else %}
        <p class="muted empty-chat">No messages yet. Be the first to start the conversation!</p>
      {% endif %}
    </div>

    <!-- Composer -->
    {% if can_post %}
      <form method="POST"
            action="/groups/{{ group.slug }}/channels/{{ channel.slug }}/messages"
            class="composer">
        <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
        <textarea name="body" rows="2" required placeholder="Write a message..." class="input"></textarea>
        <button class="btn primary" type="submit">Send</button>
      </form>
    {% else %}
      <p class="hint small muted" style="text-align:center;margin-top:1rem;">
        You can’t post in this channel.
      </p>
    {% endif %}
  </section>
</div>
{% endblock %}
