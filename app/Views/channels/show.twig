{% extends "layouts/base.twig" %}
{% block title %}{{ channel.name }} — {{ group.name }} — UAFS Social{% endblock %}

{% block body %}
<div class="page-wrap">
  <article class="page-card">
    <p class="muted">
      <a href="/groups/{{ group.slug }}">&larr; Back to {{ group.name }}</a>
    </p>

    <header class="channel-header">
      <h1>{{ channel.name }}</h1>
      <div class="channel-meta">
        <span class="badge subtle">{{ channel.kind|title }}</span>
        {% if channel.is_readonly %}
          <span class="badge subtle">Readonly</span>
        {% endif %}
      </div>
    </header>

    <hr>

    <section>
      <p class="muted">No posts here yet. (We’ll add messages/announcements next sprint.)</p>
    </section>
  </article>
</div>
{% endblock %}
