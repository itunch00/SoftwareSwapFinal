{% extends "layouts/base.twig" %}
{% block title %}Direct Message — UAFS Social
{% endblock %}

{% block body %}
<div class="page-wrap">

  <div class="page-card">
    <!-- Breadcrumb -->
    <div class="breadcrumb">
      <a href="/home">Home</a> &raquo;
      <a href="/dms">Messages</a> &raquo;
      <span>Conversation</span>
    </div>

    <h1>Direct Message</h1>

    {% if partner %}
      <p class="muted small">
        With: {{ partner.name ?? partner.display_name }} ({{ partner.email }})
      </p>
    {% endif %}

    <!-- Message List -->
    <section class="messages">
      {% if messages and messages|length > 0 %}
        <ul class="message-list">
          {% for m in messages %}
            {% set mine = (m.sender_id == me.id) %}
            <li id="msg-{{ m.id }}" class="message {{ mine ? 'mine' : 'theirs' }}">
              <div class="message-head">
                <strong>
                  {% if mine %}
                    You
                  {% else %}
                    <a href="/profile/{{ partner.id }}" class="user-link">
                      {{ partner.name ?? partner.display_name ?? ('User #' ~ partner.id) }}
                    </a>
                  {% endif %}
                </strong>
                <span class="muted small">{{ m.created_at|date('M j, Y · h:i a') }}</span>
              </div>
              <div class="message-body">{{ m.body|e }}</div>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="muted">No messages yet.</p>
      {% endif %}
    </section>

    <!-- Composer -->
    <form id="dm-form" method="POST" action="/dms/{{ conv.id }}/messages" class="message-composer">
      <input type="hidden" name="_csrf" value="{{ csrf_token }}">

      <!-- Divider -->
      <div class="composer-divider"></div>

      <textarea id="body" name="body" rows="3" placeholder="Write a message..." required></textarea>
      <button class="btn primary" type="submit">Send</button>
    </form>
  </div>
</div>

<!-- Scripts -->
<script>
document.addEventListener("DOMContentLoaded", function() {
  // Auto-focus composer
  const ta = document.getElementById('body');
  if (ta) ta.focus();

  // Auto-scroll to bottom of messages on load
  const list = document.querySelector('.message-list');
  if (list) list.scrollTop = list.scrollHeight;

  // Cmd/Ctrl+Enter to submit
  if (ta) {
    ta.addEventListener('keydown', function(e) {
      const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
      const combo = (isMac && e.metaKey && e.key === 'Enter') || (!isMac && e.ctrlKey && e.key === 'Enter');
      if (combo) {
        e.preventDefault();
        document.getElementById('dm-form').submit();
      }
    });
  }

  // Poll new messages every 1 second
  let lastSeenId = {{ messages|last ? messages|last.id : 'null' }};
  const pollUrl = "/dms/{{ conv.id }}/poll";
  const msgList = document.querySelector(".message-list");

  function formatTimestamp(raw) {
    const dt = new Date(raw);
    dt.setHours(dt.getHours() - 6);
    return dt.toLocaleString(undefined, { year: 'numeric', month: 'numeric', day: 'numeric', hour: 'numeric', minute: 'numeric' });
  }

  setInterval(() => {
    fetch(pollUrl, { headers: { "Accept": "application/json" } })
      .then(res => res.json())
      .then(data => {
        if (!data.latest_message) return;
        const m = data.latest_message;
        if (!lastSeenId || m.id > lastSeenId) {
          lastSeenId = m.id;
          const mine = (m.sender_id == {{ me.id }});
          const li = document.createElement("li");
          li.id = "msg-" + m.id;
          li.className = "message " + (mine ? "mine" : "theirs");
          li.innerHTML = `
            <div class="message-head">
              <strong>${mine ? "You" : "{{ partner.name ?? partner.display_name ?? ('User #' ~ partner.id) }}"} </strong>
              <span class="muted small">${formatTimestamp(m.created_at)}</span>
            </div>
            <div class="message-body">${m.body}</div>
          `;
          msgList.appendChild(li);
          msgList.scrollTop = msgList.scrollHeight;
        }
      })
      .catch(err => console.error("DM Poll Error:", err));
  }, 1000);
});
</script>

<!-- Styles -->
<style>
/* Messages */
.message-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  max-height: 60vh;
  overflow-y: auto;
}

.message {
  border-radius: 14px;
  padding: 0.5rem 0.75rem;
  max-width: 72%;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.message-head {
  display: flex;
  justify-content: space-between;
  gap: 0.75rem;
}

.message-body {
  white-space: pre-wrap;
}

/* Sent vs Received */
.message.mine {
  align-self: flex-end;
  background: #e6f2ff;
  border: 1px solid #b3d4ff;
}

.message.theirs {
  align-self: flex-start;
  background: #f3f4f6;
  border: 1px solid #e5e7eb;
}

/* Composer */
.message-composer {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-top: 1rem;
}

.message-composer textarea {
  width: 100%;
  padding: 0.75rem 1rem;
  border-radius: 8px;
  border: 1px solid #ccc;
  font-size: 1rem;
  resize: none; /* disable resizing */
}

.message-composer button {
  align-self: flex-end;
  padding: 0.6rem 1.2rem;
  border-radius: 6px;
}

/* Divider */
.composer-divider {
  width: 100%;
  height: 1px;
  background: #e5e7eb;
  margin-bottom: 0.5rem;
}
</style>
{% endblock %}
