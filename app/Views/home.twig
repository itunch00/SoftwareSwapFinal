{% extends "layouts/base.twig" %}
{% block title %}Home — UAFS Social{% endblock %}

{% block body %}
<div class="page-wrap">

  {# Flash messages (kept) #}
  {% set f = flash() %}
  {% for msg in f.success ?? [] %}
    <div class="alert alert-success">{{ msg }}</div>
  {% endfor %}
  {% for msg in f.error ?? [] %}
    <div class="alert alert-error">{{ msg }}</div>
  {% endfor %}

  {# Welcome #}
  <section style="text-align:center; color:white;">
  <h1>Welcome, {{ user.name }}!</h1>
  <p>Role: {{ user.role|title }}</p>
  </section>

  {% if admin_groups is defined %}
    {# ================= Admin: All Groups ================= #}
    <article class="page-card">
      <header style="display:flex;justify-content:space-between;align-items:center;gap:.5rem;flex-wrap:wrap">
        <h2 style="margin:0">All Groups ({{ admin_groups.total }})</h2>

        <form method="get" action="/home" class="group-filters">
          <select name="sort">
            <option value="newest" {{ admin_groups.sort=='newest'?'selected':'' }}>Newest</option>
            <option value="name"   {{ admin_groups.sort=='name'  ?'selected':'' }}>Name</option>
          </select>
          <select name="per">
            {% for n in [12,24,36,48] %}
              <option value="{{ n }}" {{ admin_groups.per==n?'selected':'' }}>{{ n }}/page</option>
            {% endfor %}
          </select>
          <button type="submit">Apply</button>
        </form>
      </header>

      {# grid of groups #}
      <div class="group-grid">
        {% for g in admin_groups.items %}
          <div class="group-card">
            <div class="group-header">
              <a class="group-name" href="/groups/{{ g.slug }}">{{ g.name }}</a>
              {% if g.visibility == 'public' %}
                <span class="badge public">PUBLIC</span>
              {% else %}
                <span class="badge private">PRIVATE</span>
              {% endif %}
            </div>
            {% if g.description %}
              <p class="group-desc">{{ g.description }}</p>
            {% endif %}
          </div>
        {% else %}
          <p class="muted">No groups found.</p>
        {% endfor %}
      </div>

      {# pagination controls #}
      {% if admin_groups.pages > 1 %}
        <nav aria-label="Groups pagination" style="display:flex;gap:.5rem;align-items:center;justify-content:center;margin-top:1rem;flex-wrap:wrap">
          {% set qparams = {
            'q': admin_groups.q,
            'sort': admin_groups.sort,
            'per': admin_groups.per
          } %}
          {% set prev = admin_groups.page - 1 %}
          {% set next = admin_groups.page + 1 %}

          <a class="btn small ghost" href="/home?{{ qparams|merge({'page':1})|url_encode }}"  {{ admin_groups.page==1 ? 'aria-disabled=\"true\"' : '' }}>« First</a>
          <a class="btn small ghost" href="/home?{{ qparams|merge({'page':prev})|url_encode }}" {{ admin_groups.page==1 ? 'aria-disabled=\"true\"' : '' }}>‹ Prev</a>

          {% set start = max([1, admin_groups.page - 2]) %}
          {% set end   = min([admin_groups.pages, admin_groups.page + 2]) %}
          {% for p in start..end %}
            {% set link = "/home?" ~ (qparams|merge({'page':p})|url_encode) %}
            <a class="btn small {{ p==admin_groups.page ? 'primary':'ghost' }}" href="{{ link }}">{{ p }}</a>
          {% endfor %}

          <a class="btn small ghost" href="/home?{{ qparams|merge({'page':next})|url_encode }}" {{ admin_groups.page==admin_groups.pages ? 'aria-disabled=\"true\"' : '' }}>Next ›</a>
          <a class="btn small ghost" href="/home?{{ qparams|merge({'page':admin_groups.pages})|url_encode }}">Last »</a>
        </nav>
      {% endif %}
    </article>


  {% else %}
    {# ================= Member: Your Groups ================= #}
    <section class="page-card" id="your-groups">
      <h2>Your Groups</h2>

      {% if your_groups and your_groups|length > 0 %}
        <div class="group-grid">
          {% for g in your_groups %}
            <div class="group-card">
              <div class="group-header">
                <a href="/groups/{{ g.slug }}" class="group-name">{{ g.name }}</a>
                <span class="badge {{ g.visibility }}">{{ g.visibility|title }}</span>
              </div>

              {% if g.description %}
                <p class="group-desc">{{ g.description }}</p>
              {% endif %}

              {% if g.member_count is defined %}
                <div class="small muted" style="margin-top:0.5rem;">
                  👥 {{ g.member_count }} members
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>

        {# Button under the group grid #}
        <button class="btn primary open-create-modal" style="margin-top: 1rem;">
          + Create Group
        </button>


      {% else %}

        <p class="muted">
          You’re not part of any groups yet. Create one below to get started.
        </p>

        {# Button under the empty message #}
        <button class="btn primary open-create-modal">+ Create Group</button>

      {% endif %}
    </section>

    {# ================= Explore Public Groups ================= #}
    <section class="page-card" id="explore" style="margin-bottom: 2rem;">
      <h2>Explore Public Groups</h2>
      {% if public_groups and public_groups|length > 0 %}
        <div class="group-grid">
          {% for g in public_groups %}
            <div class="group-card">
              <div class="group-header">
                <a href="/groups/{{ g.slug }}" class="group-name">{{ g.name }}</a>
                <span class="badge {{ g.visibility }}">{{ g.visibility|title }}</span>
              </div>
              {% if g.description %}
                <p class="group-desc">{{ g.description }}</p>
              {% endif %}
              <form method="post" action="/groups/{{ g.slug }}/join" style="margin-top:.75rem;">
                <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                <button class="btn primary small" type="submit">Join</button>
              </form>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <p class="muted">No public groups to explore right now.</p>
      {% endif %}
    </section>
  {% endif %}

  




</div>


{# ================= Create Group Modal ================= #}
<div id="uafs-modal-overlay" class="uafs-hidden">
  <div id="uafs-modal">
    <header id="uafs-modal-header">
      <h2>Create a Group</h2>
      <button type="button" id="uafs-close-modal" aria-label="Close">&times;</button>

    </header>

    <form method="POST" action="/groups" id="uafs-modal-form" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrf_token() }}">

      <div class="uafs-field">
        <label for="uafs-name">Name</label>
        <input id="uafs-name" name="name" required placeholder="e.g., CS Seniors 2025" />
      </div>

      <div class="uafs-field">
        <label for="uafs-desc">Description <span class="uafs-muted">(optional)</span></label>
        <input id="uafs-desc" name="description" placeholder="Short description" />
      </div>

      <div class="uafs-field">
        <label for="uafs-vis">Visibility</label>
        <select id="uafs-vis" name="visibility" required>
          <option value="public" selected>public</option>
          <option value="private">private</option>
        </select>
      </div>

      <button class="uafs-btn" type="submit">Create Group</button>
    </form>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const overlay = document.getElementById("uafs-modal-overlay");
  const closeBtn = document.getElementById("uafs-close-modal");
  const openButtons = document.querySelectorAll(".open-create-modal");

  console.log("Modal overlay:", overlay);
  console.log("Close button:", closeBtn);

  // OPEN buttons
  openButtons.forEach(btn => {
    console.log("Binding OPEN button:", btn);
    btn.addEventListener("click", () => {
      console.log("OPEN CLICKED");
      overlay.classList.remove("uafs-hidden");
    });
  });

  // CLOSE button
  closeBtn.addEventListener("click", (e) => {
    console.log("CLOSE button clicked:", e);
    overlay.classList.add("uafs-hidden");
  });

  // Background close
  overlay.addEventListener("click", (e) => {
    console.log("Overlay clicked");
    if (e.target === overlay) {
      console.log("Closing from background click");
      overlay.classList.add("uafs-hidden");
    }
  });
});
</script>





{% endblock %}
