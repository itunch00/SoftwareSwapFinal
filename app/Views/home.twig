{% extends "layouts/base.twig" %}
{% block title %}Home — UAFS Social{% endblock %}

{% block body %}
<div class="page-wrap">

  {% set f = flash() %}
  {% for msg in f.success ?? [] %}
    <div class="alert alert-success">{{ msg }}</div>
  {% endfor %}
  {% for msg in f.error ?? [] %}
    <div class="alert alert-error">{{ msg }}</div>
  {% endfor %}

  <!-- Welcome -->
  <section class="page-card" style="text-align:center;">
    <h1>Welcome, {{ user.name }}!</h1>
    <p class="muted">Role: {{ user.role|title }}</p>
    <form method="post" action="/logout" class="form-inline" style="margin-top:1rem;">
      <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
      <button class="btn secondary" type="submit">Logout</button>
    </form>
  </section>

  {% if admin_groups is defined %}
    <!-- Admin: All Groups -->
    <section class="page-card" id="explore">
      <h2>All Groups</h2>
      {% if admin_groups and admin_groups|length > 0 %}
        <div class="group-grid">
          {% for g in admin_groups %}
            <div class="group-card">
              <div class="group-header">
                <a href="/groups/{{ g.slug }}" class="group-name">{{ g.name }}</a>
                <span class="badge {{ g.visibility }}">{{ g.visibility|title }}</span>
              </div>
              {% if g.description %}
                <p class="group-desc">{{ g.description }}</p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% else %}
        <p class="muted">No groups found.</p>
      {% endif %}
    </section>

  {% else %}
    <!-- Your Groups -->
    <section class="page-card" id="your-groups">
      <h2>Your Groups</h2>
      {% if your_groups and your_groups|length > 0 %}
        <div class="group-grid">
          {% for g in your_groups %}
            <div class="group-card">
              <div class="group-header">
                <a href="/groups/{{ g.slug }}" class="group-name">{{ g.name }}</a>
                <span class="badge {{ g.visibility }}">{{ g.visibility|title }}</span>
              </div>
              {% if g.description %}
                <p class="group-desc">{{ g.description }}</p>
              {% endif %}
              {% if g.member_count is defined %}
                <div class="small muted" style="margin-top:0.5rem;">
                  👥 {{ g.member_count }} members
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% else %}
        <p class="muted">You’re not part of any groups yet. Create one below to get started.</p>
      {% endif %}
    </section>

    <!-- Explore Public Groups -->
    <section class="page-card" id="explore">
      <h2>Explore Public Groups</h2>
      {% if public_groups and public_groups|length > 0 %}
        <div class="group-grid">
          {% for g in public_groups %}
            <div class="group-card">
              <div class="group-header">
                <a href="/groups/{{ g.slug }}" class="group-name">{{ g.name }}</a>
                <span class="badge {{ g.visibility }}">{{ g.visibility|title }}</span>
              </div>
              {% if g.description %}
                <p class="group-desc">{{ g.description }}</p>
              {% endif %}
              <form method="post" action="/groups/{{ g.slug }}/join" style="margin-top:.75rem;">
                <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                <button class="btn primary small" type="submit">Join</button>
              </form>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <p class="muted">No public groups to explore right now.</p>
      {% endif %}
    </section>
  {% endif %}

  <!-- Create Group -->
  <section class="page-card" id="new-group">
    <h2>Create a Group</h2>
    <form method="POST" action="/groups" class="form">
      <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
      <div class="form-row">
        <label for="g-name">Name</label>
        <input id="g-name" name="name" required placeholder="e.g., CS Seniors 2025">
      </div>
      <div class="form-row">
        <label for="g-desc">Description <span class="muted">(optional)</span></label>
        <input id="g-desc" name="description" placeholder="Short description">
      </div>
      <div class="form-row">
        <label for="g-vis">Visibility</label>
        <select id="g-vis" name="visibility">
          <option value="public">public</option>
          <option value="private">private</option>
        </select>
      </div>
      <div class="form-actions">
        <button class="btn primary" type="submit">Create Group</button>
      </div>
    </form>
  </section>

</div>
{% endblock %}
