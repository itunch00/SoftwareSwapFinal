{% extends "layouts/base.twig" %}
{% block title %}{{ group.name }} — UAFS Campfire{% endblock %}
{% block body %}
<div class="page-wrap">

  {# Flash messages #}
  {% set f = flash() %}
  {% for msg in f.success ?? [] %}<div class="alert alert-success">{{ msg }}</div>{% endfor %}
  {% for msg in f.error ?? [] %}<div class="alert alert-error">{{ msg }}</div>{% endfor %}

  <!-- Group Header -->
  <article class="page-card">
    <div class="breadcrumb">
      <a href="/home">Home</a> &raquo; <span>{{ group.name }}</span>
    </div>

    <header class="group-header">
      <div>
        <h1>{{ group.name }}</h1>
        {% if group.description %}<p class="muted">{{ group.description }}</p>{% endif %}
      </div>
      <span class="badge {{ group.visibility }}">{{ group.visibility|title }}</span>

      {% if viewer and viewer.role == 'admin' %}
        <form method="post" action="/admin/groups/{{ group.id }}/delete" style="display:inline; margin-left:.5rem;">
          <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
          <button class="btn danger" type="submit">Delete Group</button>
        </form>
      {% endif %}
    </header>

    {# Join/Leave — skip entirely for admin #}
    {% if viewer and viewer.role != 'admin' %}
      <div class="group-actions">
        {% if is_member %}
          <form method="post" action="/groups/{{ group.slug }}/leave">
            <input type="hidden" name="_csrf" value="{{ csrf_token() }}" />
            <button class="btn secondary" type="submit">Leave group</button>
          </form>
        {% else %}
          <form method="post" action="/groups/{{ group.slug }}/join">
            <input type="hidden" name="_csrf" value="{{ csrf_token() }}" />
            <button class="btn primary" type="submit">Join group</button>
          </form>
        {% endif %}
      </div>
    {% elseif not viewer %}
      <p class="hint small">Sign in to join this group.</p>
    {% endif %}
  </article>

  <!-- 💬 Channels List (card 1) -->
  <section class="page-card">
    <h2>Channels</h2>

    {% if can_view %}
      {% if channels %}
        <ul class="channel-list">
          {% for channel in channels %}
            <li class="channel-item">
              <a class="channel-link" href="/groups/{{ group.slug }}/channels/{{ channel.slug }}">
                <span class="channel-name">{{ channel.name }}</span>
              </a>

              {% if channel.kind != 'general' %}
                <span class="badge subtle">{{ channel.kind|title }}</span>
              {% endif %}
              {% if channel.is_readonly %}
                <span class="badge subtle">Readonly</span>
              {% endif %}

              {% if viewer and viewer.role == 'admin' %}
                <form method="post"
                      action="/groups/{{ group.slug }}/channels/{{ channel.slug }}/delete"
                      style="display:inline;margin-left:.5rem">
                  <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                  <button class="btn danger small" type="submit" title="Delete channel">🗑️</button>
                </form>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="muted">No channels have been created yet.</p>
      {% endif %}
    {% else %}
      {% if viewer and viewer.role == 'admin' %}
        <p class="muted small">Admin view (you are not a member of this private group).</p>
      {% else %}
        <p>This group is {{ group.visibility }}. Join the group to see its channels.</p>
        {% if viewer and viewer.role != 'admin' %}
          <div class="group-actions">
            {% if is_member %}
              <form method="post" action="/groups/{{ group.slug }}/leave">
                <input type="hidden" name="_csrf" value="{{ csrf_token() }}" />
                <button class="btn secondary" type="submit">Leave group</button>
              </form>
            {% else %}
              <form method="post" action="/groups/{{ group.slug }}/join">
                <input type="hidden" name="_csrf" value="{{ csrf_token() }}" />
                <button class="btn primary" type="submit">Join group</button>
              </form>
            {% endif %}
          </div>
        {% endif %}
      {% endif %}
    {% endif %}
  </section>

  {% if can_view and viewer and (viewer.role == 'admin' or (is_member and viewer.role == 'faculty')) %}
    <section class="page-card" id="new-group">
      <h2>Create a Channel</h2>

      <form method="POST" action="/groups/{{ group.slug }}/channels" class="auth-form" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrf_token() }}">

        <div class="field">
          <label for="ch-name">Name</label>
          <input id="ch-name" name="name" required placeholder="e.g., announcements, general" />
        </div>

        <div class="field">
          <label for="ch-desc">Description <span class="muted">(optional)</span></label>
          <input id="ch-desc" name="description" placeholder="Short description" />
        </div>

        <div class="field">
          <label for="ch-vis">Visibility</label>
          <select id="ch-vis" name="visibility" required>
            <option value="public" selected>public</option>
            <option value="private">private</option>
          </select>
        </div>

        <div class="field field-inline">
          <label for="ch-readonly">Read-only <span class="muted">(good for Announcements)</span></label>
          <input type="checkbox" id="ch-readonly" name="readonly" value="1">
        </div>

        <button class="btn primary" type="submit">Create Channel</button>
      </form>
    </section>
  {% endif %}

</div>
{% endblock %}
