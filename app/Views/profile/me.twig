{% extends "layouts/base.twig" %}
{% block title %}My Profile — UAFS Social{% endblock %}

{% block body %}
{% set me = app.user %}

<div class="auth-wrap">
  <div class="auth-card">

    {# flash inside the card #}
    {% set f = flash() %}
    {% for msg in f.success ?? [] %}<div class="alert alert-success">{{ msg }}</div>{% endfor %}
    {% for msg in f.error ?? [] %}<div class="alert alert-error">{{ msg }}</div>{% endfor %}

    <div class="breadcrumb small" style="margin-bottom:.25rem;">
      <a href="/home">Home</a> &raquo; <span>My Profile</span>
    </div>

    <header class="auth-header">
      <h1>My Profile</h1>
      <p class="subtitle">Manage how your profile appears to others.</p>
    </header>

    {% if error %}
      <div class="alert" role="alert" aria-live="polite">{{ error }}</div>
    {% endif %}

    <form method="post" action="/profile" class="auth-form" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrf_token() }}">

      <div class="field">
        <label for="display_name">Display name</label>
        <input id="display_name" name="display_name" type="text" value="{{ user.display_name }}" required />
      </div>

      <div class="field">
        <label for="bio">Bio</label>
        <textarea id="bio" name="bio" rows="4" placeholder="Tell others about yourself...">{{ profile.bio ?? '' }}</textarea>
        <div class="hint small">Max 2000 characters.</div>
      </div>

      <div class="field">
        <label for="website">Website</label>
        <input id="website" name="website" type="url" placeholder="https://example.com" value="{{ profile.website ?? '' }}" />
      </div>

      <div class="field">
        <label for="github">GitHub</label>
        <input id="github" name="github" type="url" placeholder="https://github.com/username" value="{{ profile.github ?? '' }}" />
      </div>

      <div class="field">
        <label for="linkedin">LinkedIn</label>
        <input id="linkedin" name="linkedin" type="url" placeholder="https://www.linkedin.com/in/username" value="{{ profile.linkedin ?? '' }}" />
      </div>

      <div class="field">
        <label for="pronouns">Pronouns</label>
        <input id="pronouns" name="pronouns" type="text" placeholder="e.g., she/her, he/him, they/them" value="{{ profile.pronouns ?? '' }}" />
      </div>

      <div class="field">
        <label for="timezone">Timezone</label>
        <input id="timezone" name="timezone" type="text" placeholder="e.g., America/Chicago" value="{{ profile.timezone ?? '' }}" />
      </div>

      <button class="btn primary" type="submit">Save changes</button>
    </form>

    {# ---------- Admin moderation (only when editing someone else) ---------- #}
    {% if me and me.role == 'admin' and user and user.id != me.id %}
      <hr style="margin:1.25rem 0;">

      <h2 class="muted" style="font-size:1.05rem;margin:.25rem 0 0.75rem;">Admin moderation</h2>

      {% if user.banned_until and user.banned_until > "now"|date('Y-m-d H:i:s') %}
        <p class="alert alert-error" style="margin:.25rem 0 1rem;">
          <strong>Currently banned</strong> until {{ user.banned_until }}{% if user.ban_reason %}. Reason: {{ user.ban_reason }}{% endif %}.
        </p>
        <form method="post" action="/admin/users/{{ user.id }}/unban" class="auth-form" style="gap:.5rem;">
          <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
          <button class="btn secondary" type="submit">Unban user</button>
        </form>
      {% else %}
        <form method="post" action="/admin/users/{{ user.id }}/ban" class="auth-form" style="gap:.5rem;">
          <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
          <div class="field">
            <label for="ban_days">Ban duration (days)</label>
            <input id="ban_days" name="days" type="number" min="1" value="3" required />
          </div>
          <div class="field">
            <label for="ban_reason">Reason (optional)</label>
            <input id="ban_reason" name="reason" type="text" placeholder="Reason (optional)" />
          </div>
          <button class="btn danger" type="submit">Ban user</button>
        </form>
      {% endif %}
    {% endif %}
    {# ---------- /Admin moderation ---------- #}

  </div>
</div>
{% endblock %}
