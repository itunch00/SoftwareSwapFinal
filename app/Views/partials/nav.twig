{% set me = app.user is defined ? app.user : (user is defined ? user : null) %}

<nav class="topnav" role="navigation" aria-label="Primary">
  <a class="brand" href="/">
    <img src="/assets/uafsLion.png" alt="UAFS Logo" style="height:36px;width:auto;border-radius:6px;">
  </a>

  {# Desktop links (icons only) #}
  <div class="nav-links">
    <a class="nav-link {{ is_active('/home') ? 'active' : '' }}" href="/home" title="Home" aria-label="Home">
      <i class="bi bi-house-door"></i>
    </a>
    <a class="nav-link {{ is_active('/dms') ? 'active' : '' }}" href="/dms" title="Direct Messages" aria-label="DMs">
      <i class="bi bi-chat-dots"></i>
    </a>

    {% if me and me.role is defined and me.role in ['admin'] %}
      <a class="nav-link {{ is_active('/admin/users') ? 'active' : '' }}" href="/admin/users" title="Admin Panel" aria-label="Admin">
        <i class="bi bi-shield-lock"></i>
      </a>
    {% endif %}

    <a class="nav-link {{ is_active('/profile') ? 'active' : '' }}" href="/profile" title="Profile" aria-label="Profile">
      <i class="bi bi-person-circle"></i>
    </a>

    <form method="post" action="/logout" class="d-inline-block m-0 p-0" title="Logout" aria-label="Logout">
      <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
      <button class="nav-link" type="submit" style="background:none;border:none;padding:0;">
        <i class="bi bi-box-arrow-right"></i>
      </button>
    </form>
  </div>

  {# Mobile hamburger #}
  <button class="hamburger" type="button" aria-label="Open menu" aria-controls="mobileMenu" aria-expanded="false">
    <span class="hamburger-box"><span class="hamburger-inner"></span></span>
  </button>
</nav>

{# Mobile drawer (icons + text) #}
<div id="mobileMenu" class="mobile-drawer" hidden>
  <div class="mobile-head">
    <strong>Menu</strong>
    <button type="button" data-close aria-label="Close">✕</button>
  </div>

  <a class="mobile-link" href="/home"><i class="bi bi-house-door"></i> Home</a>
  <a class="mobile-link" href="/dms"><i class="bi bi-chat-dots"></i> DMs</a>

  {% if me and me.role is defined and me.role in ['admin'] %}
    <a class="mobile-link" href="/admin/users"><i class="bi bi-shield-lock"></i> Admin</a>
  {% endif %}

  <a class="mobile-link" href="/profile"><i class="bi bi-person-circle"></i> Profile</a>

  <div class="divider"></div>
  <form method="post" action="/logout">
    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
    <button type="submit" class="mobile-link"><i class="bi bi-box-arrow-right"></i> Logout</button>
  </form>
</div>

{# Bootstrap Icons + Drawer Toggler Script #}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<script>
(function(){
  const btn = document.querySelector('.topnav .hamburger');
  const drawer = document.getElementById('mobileMenu');
  if(!btn || !drawer) return;

  function openDrawer(){
    drawer.hidden = false;
    btn.setAttribute('aria-expanded','true');
    document.body.classList.add('nav-open');
  }
  function closeDrawer(){
    drawer.hidden = true;
    btn.setAttribute('aria-expanded','false');
    document.body.classList.remove('nav-open');
  }

  btn.addEventListener('click', () => drawer.hidden ? openDrawer() : closeDrawer());
  drawer.addEventListener('click', (e) => {
    if(e.target.matches('[data-close], a.mobile-link, form button')) closeDrawer();
  });
  window.addEventListener('resize', () => { if (window.innerWidth >= 768) closeDrawer(); });
})();
</script>
